# Browser + Next.js API routes. Include /stag/v1. Trailing slash optional.
# Unset or blank → https://api-dev.stag.org.in/stag/v1 (same as before).
#
# Local against a machine API:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/stag/v1
#
# Netlify / hosted (set per site or deploy context):
# DEV → https://api-dev.stag.org.in/stag/v1
# QA  → https://api-qa.stag.org.in/stag/v1
NEXT_PUBLIC_API_BASE_URL=
